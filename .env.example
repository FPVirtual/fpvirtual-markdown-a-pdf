# Imagen pandoc con la plantilla FPVirtual (se construye en el proyecto fpvirtual-pandoc-theme)
PANDOC_IMAGE=fpvirtual-pandoc:latest

# Puerto en el host donde se publica la aplicación
PORT=3000

# Tamaño máximo total de subida (MB)
NUXT_MAX_UPLOAD_MB=50

# Directorio de trabajo para las conversiones (misma ruta en host y contenedor).
# Por defecto: <directorio del proyecto>/data
# WORKSPACE_DIR=/ruta/absoluta/data

# Directorio con la plantilla FPVirtual (misma ruta en host y contenedor).
# Por defecto: <directorio del proyecto>/fpvirtual-theme
# THEME_DIR=/ruta/absoluta/fpvirtual-theme
